<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- roothide-targeted entitlements. Same as Runner.entitlements (rootless)
         PLUS the four keys roothide requires for an app to run unsandboxed and
         reach other apps' bundles/containers. Do NOT merge these into the
         rootless Runner.entitlements: `platform-application` makes the process a
         platform binary, which is harmless/required under roothide but can break
         a plain rootless (Dopamine) app launch. build_deb.sh selects this file
         via OPERIT_PACK_SCHEME=roothide. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
    <key>com.apple.private.security.no-sandbox</key>
    <true/>
    <key>platform-application</key>
    <true/>
    <key>com.apple.private.security.storage.AppBundles</key>
    <true/>
    <key>com.apple.private.security.storage.AppDataContainers</key>
    <true/>
    <key>com.apple.private.security.container-required</key>
    <false/>
    <!-- Required for Flutter/Impeller Metal rendering on iOS. -->
    <key>com.apple.security.iokit-user-client-class</key>
    <array>
        <string>AGXDeviceUserClient</string>
        <string>IOSurfaceRootUserClient</string>
    </array>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
    <key>get-task-allow</key>
    <true/>
    <!-- Screen Time (FamilyControls) shield API, iOS 16+. -->
    <key>com.apple.developer.family-controls</key>
    <true/>
    <!-- Shared container with the ScreenTimeMonitor app extension. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>group.com.ai.assistance.operit</string>
    </array>
    <key>application-identifier</key>
    <string>com.ai.assistance.operit2</string>
    <key>keychain-access-groups</key>
    <array>
        <string>com.ai.assistance.operit2</string>
    </array>
</dict>
</plist>
