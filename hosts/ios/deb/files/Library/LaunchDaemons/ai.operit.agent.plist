<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.operit.agent</string>
    <key>ProgramArguments</key>
    <array>
        <!-- 源文件必须写 /usr/bin（roothide 用）；rootless 由 packdeb.py 加 /var/jb 前缀。
             曾因直接写 /var/jb/usr/bin 导致 packdeb 子串替换成 /var/jb/var/jb/usr/bin 双前缀（0.3.71+ 回归）-->
        <string>/usr/bin/operit_agent_daemon</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>5</integer>
    <key>UserName</key>
    <string>mobile</string>
    <key>WorkingDirectory</key>
    <string>/var/mobile</string>
    <key>StandardOutPath</key>
    <string>/var/mobile/.operit/logs/launchd.out</string>
    <key>StandardErrorPath</key>
    <string>/var/mobile/.operit/logs/launchd.err</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/var/mobile</string>
    </dict>
</dict>
</plist>
