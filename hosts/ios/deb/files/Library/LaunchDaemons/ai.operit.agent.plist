<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.operit.agent</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/operit_agent_daemon</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
    <key>UserName</key>
    <string>root</string>
    <key>WorkingDirectory</key>
    <string>/var/mobile</string>
    <key>StandardOutPath</key>
    <string>/var/jb/var/mobile/.operit/logs/launchd.out</string>
    <key>StandardErrorPath</key>
    <string>/var/jb/var/mobile/.operit/logs/launchd.err</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/var/mobile</string>
    </dict>
</dict>
</plist>
