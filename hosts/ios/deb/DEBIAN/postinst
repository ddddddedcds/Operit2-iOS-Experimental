#!/bin/sh
# Run as root on the jailbroken device after `dpkg -i` (roothide scheme only).
set -u

# roothide installs to / (dpkg remaps package paths into the random jbroot);
# rootless installs to /var/jb. Detect so the paths below are correct on both.
#
# CRITICAL: do NOT test bare `/var/jb` existence to tell the two apart. On a
# real roothide device `/var/jb` exists too (it is a symlink into the jbroot),
# so the old `[ -L /var/jb ] || [ -d /var/jb/usr ]` rule silently mis-detected
# roothide as rootless and pointed every path at a non-writable tree. Require a
# *real* rootless subtree (`/var/jb/usr/lib`); the buggy tweak never created
# that, so its presence is an unambiguous rootless signal.
if [ -d /var/jb/usr/lib ]; then
  JB=/var/jb
else
  JB=
fi
echo "== Operit2 iOS install (JB prefix='${JB:-<none>}') =="

# Self-heal: purge the bogus /var/jb tree the OLD buggy build left in the real
# rootfs (/rootfs/var/jb -> /var/jb/var/mobile/.operit). The new code never routes
# any path through /var/jb on roothide, so leaving the stale tree behind only
# risks confusing future tooling. Removal is guarded so it can NEVER touch a
# legitimate jailbreak tree:
#   1. a real rootless/roothide bootstrap has /var/jb/usr/lib -> if present, skip;
#   2. only act on a plain directory at /rootfs/var/jb (never a symlink, so a
#      legit roothide /var/jb symlink is untouched);
#   3. only when it contains NO real system subdirs (usr/System/Library/bin/sbin/
#      Applications) -> i.e. it is genuinely the empty shell our bug created.
if [ ! -d /var/jb/usr/lib ] && [ -d /rootfs/var/jb ] && [ ! -L /rootfs/var/jb ]; then
  _jb_has_sys=0
  for _s in usr System Library bin sbin Applications; do
    [ -e "/rootfs/var/jb/$_s" ] && _jb_has_sys=1 && break
  done
  if [ "$_jb_has_sys" -eq 0 ]; then
    echo "== self-heal: removing leftover bogus /rootfs/var/jb (not a real jb tree) =="
    rm -rf /rootfs/var/jb 2>/dev/null || true
  else
    echo "== self-heal: /rootfs/var/jb has system subdirs; leaving it alone =="
  fi
fi

# Data directory for sockets / logs / config.
# - rootless: /var/jb/var/mobile/.operit (writable jb tree).
# - roothide: /var/mobile/.operit. The app (jbroot-injected) and the daemon
#   (system launchd) each resolve this to their OWN physical dir — that is fine,
#   because the agent control channel and config are exchanged over loopback TCP
#   (127.0.0.1:8890), which is shared across the per-process /var remap. No
#   /rootfs anchor needed.
if [ -n "$JB" ]; then
  DATA_DIR="${JB}/var/mobile/.operit"
else
  DATA_DIR="/var/mobile/.operit"
fi

# Locate the device ldid. Its install path varies by jailbreak toolchain
# (Procursus commonly uses /usr/bin/ldid, but some setups install to
# /usr/local/bin/ldid). A hardcoded /usr/bin/ldid that MISSES on the device
# means the daemon is NEVER re-signed -> AMFI SIGKILL (-9) -> white screen,
# with the failure silently swallowed. Probe the common locations instead of
# assuming one, so the log always shows whether ldid was actually found.
LDID_BIN=""
for _c in /usr/bin/ldid /usr/local/bin/ldid; do
  [ -x "$_c" ] && LDID_BIN="$_c" && break
done
[ -z "$LDID_BIN" ] && LDID_BIN="$(command -v ldid 2>/dev/null || true)"
echo "== ldid resolved to: ${LDID_BIN:-<NOT FOUND>} =="

echo "== socket / log directories =="
# NOTE: on roothide the app's view of /var/jb exists, so the DATA_DIR detection
# above may target the WRONG physical path. Chown BOTH the plain and the
# /var/jb-prefixed candidates so the app (mobile, uid 501) can actually write its
# client logs / runtime storage regardless of which path the app and daemon
# resolve to. Failures are reported, not silently swallowed.
# CRITICAL: never `mkdir -p /var/jb/...` on roothide. Creating a bare /var/jb
# permanently poisons every "is this rootless?" check made by the app, the
# daemon and this script — that is exactly what produced the white screen (the
# app resolved its data root to a root-owned /var/jb tree it cannot write).
# Only touch the jb tree when a REAL rootless install is present (/var/jb/usr).
_DATA_CANDIDATES="/var/mobile/.operit"
if [ -d /var/jb/usr/lib ]; then
  _DATA_CANDIDATES="$_DATA_CANDIDATES /var/jb/var/mobile/.operit"
elif [ -d /var/jb ]; then
  # Leftover bogus /var/jb from an older build: don't extend it, but make any
  # existing data dir inside it writable so an already-poisoned device recovers.
  [ -d /var/jb/var/mobile/.operit ] && _DATA_CANDIDATES="$_DATA_CANDIDATES /var/jb/var/mobile/.operit"
fi
for _d in $_DATA_CANDIDATES; do
  mkdir -p "$_d" 2>/dev/null || true
  if chown -R mobile:mobile "$_d" 2>/dev/null; then
    echo "   chowned $_d -> mobile:mobile OK"
  else
    echo "   WARN: chown $_d failed (likely created as root by the daemon)"
  fi
  mkdir -p "$_d/logs" 2>/dev/null || true
  chown -R mobile:mobile "$_d/logs" 2>/dev/null || true
done

# --- agent daemon (restored 0.3.65): re-sign on-device + register in trustcache ---
PINST_LOG="$DATA_DIR/logs/postinst.log"
DAEMON_BIN=${JB}/usr/bin/operit_agent_daemon
DAEMON_ENTFILE=${JB}/usr/share/operit/operit.entitlements
echo "== agent daemon re-sign + trustcache (runs as root via dpkg) =="
if [ -f "$DAEMON_BIN" ]; then
  chown root:wheel "$DAEMON_BIN" 2>/dev/null || true
  chmod 0755 "$DAEMON_BIN" 2>/dev/null || true
  # Re-sign with ldid so a trusted cert lands in the AMFI trust cache. MUST pass
  # the entitlements explicitly: a bare `ldid -S` strips platform-application +
  # no-sandbox and the daemon then fails sandbox/jbroot file-access. ldid
  # occasionally dies with 137 (SIGKILL itself) -> retry a few times.
  if [ -n "$LDID_BIN" ] && [ -f "$DAEMON_ENTFILE" ]; then
    for i in 1 2 3; do
      echo "$(date) ldid -S daemon attempt $i (using $LDID_BIN)" >> "$PINST_LOG" 2>&1
      if $LDID_BIN -S"$DAEMON_ENTFILE" "$DAEMON_BIN" >> "$PINST_LOG" 2>&1; then
        echo "$(date) daemon signed OK on attempt $i" >> "$PINST_LOG" 2>&1
        break
      else
        echo "$(date) ldid attempt $i FAILED (rc=$?), retrying" >> "$PINST_LOG" 2>&1
        sleep 1
      fi
    done
    # Dump entitlements actually applied (evidence for debugging -9).
    echo "$(date) daemon entitlements after sign:" >> "$PINST_LOG" 2>&1
    $LDID_BIN -e "$DAEMON_BIN" >> "$PINST_LOG" 2>&1 || true
  else
    echo "$(date) WARN: ldid/entitlements missing; daemon will likely SIGKILL (-9)" >> "$PINST_LOG" 2>&1
  fi
  # CRITICAL (0.3.65): an ldid re-sign changes the daemon's cdhash. If that
  # cdhash is NOT in the jailbreak trustcache, AMFI SIGKILLs the binary at exec
  # (launchctl ExitCode 9, 8890 never listens). Register the freshly-signed
  # binary so the kernel trusts it. Needs root — and dpkg postinst runs as root,
  # so this is the right place. Probe jbctl (Dopamine) since its path varies.
  JBCTL="$(command -v jbctl 2>/dev/null || true)"
  [ -z "$JBCTL" ] && [ -x /basebin/jbctl ] && JBCTL=/basebin/jbctl
  if [ -n "$JBCTL" ]; then
    echo "$(date) registering daemon cdhash in trustcache via $JBCTL ..." >> "$PINST_LOG" 2>&1
    if $JBCTL trustcache add "$DAEMON_BIN" >> "$PINST_LOG" 2>&1; then
      echo "$(date) trustcache add OK" >> "$PINST_LOG" 2>&1
    else
      echo "$(date) WARN: jbctl trustcache add failed (rc=$?) — daemon may -9" >> "$PINST_LOG" 2>&1
    fi
    $JBCTL trustcache info >> "$PINST_LOG" 2>&1 || true
  else
    echo "$(date) WARN: jbctl not found; cannot register daemon in trustcache (may -9)" >> "$PINST_LOG" 2>&1
  fi
else
  echo "   (no daemon binary at $DAEMON_BIN; agent daemon not included)"
fi

echo "== load agent daemon =="
# Do NOT let `launchctl load` block postinst: if the daemon loops on launch,
# launchctl would hang and break the install. Dopamine's launchdhook auto-injects
# JBROOT/Library/LaunchDaemons anyway, and RunAtLoad in the plist makes launchd
# start the daemon independently of this step.
load_daemon() {
  _plist="$1"
  if [ -f "$_plist" ]; then
    timeout 10 launchctl load "$_plist" 2>/dev/null || \
      timeout 10 launchctl bootstrap system "$_plist" 2>/dev/null || true
  fi
}
if [ -n "$JB" ]; then
  load_daemon ${JB}/Library/LaunchDaemons/ai.operit.agent.plist
else
  load_daemon /Library/LaunchDaemons/ai.operit.agent.plist
fi
APP_ENTFILE=${JB}/usr/share/operit/operit.entitlements

echo "== NOTE: 安装脚本不自动 respring（sbreload 会重启 SpringBoard，而 Sileo/Zebra 等本身跑在 SpringBoard 上，自杀式 respring 会中断安装器并留下半配置状态）=="
echo "   装完后请手动 respring：Sileo 设置内按钮，或终端 sbreload，使 SpringBoard tweak 生效。"

echo "== frontend app install (sign + register) =="
APP=${JB}/Applications/Runner.app
if [ -d "$APP" ]; then
  # Re-sign app binaries on-device with the SAME entitlements the build used
  # (Runner.roothide.entitlements: no-sandbox + iokit for Metal/IOSurface).
  # A bare `ldid -S` (no file) would STRIP those keys -> Impeller SIGABRT / Metal
  # denied at launch. If ldid or the entitlements file is missing, skip and let
  # AppSync Unified (already installed) sign the app instead.
  if [ -n "$LDID_BIN" ] && [ -f "$APP_ENTFILE" ]; then
    echo "   signing app executables with entitlements (best-effort) ..."
    for bin in "$APP/Runner" \
               "$APP/Frameworks/Flutter.framework/Flutter" \
               "$APP/Frameworks/App.framework/App" \
               "$APP/Frameworks/objective_c.framework/objective_c"; do
      [ -f "$bin" ] && $LDID_BIN -S"$APP_ENTFILE" "$bin" 2>/dev/null || true
    done
    find "$APP/Frameworks" -maxdepth 1 -name "*.dylib" -type f -exec $LDID_BIN -S"$APP_ENTFILE" {} \; 2>/dev/null || true
  else
    echo "   (ldid or entitlements missing; relying on AppSync Unified to sign app)"
  fi
  chown -R root:wheel "$APP" 2>/dev/null || true
  find "$APP" -type d -exec chmod 0755 {} \; 2>/dev/null || true
  chmod 0755 "$APP/Runner" 2>/dev/null || true
  if command -v uicache >/dev/null 2>&1; then uicache 2>/dev/null || true; fi
  echo "   app registered at $APP"
else
  echo "   (no bundled app found at $APP; frontend not included in this deb)"
fi

echo "Operit2 iOS installed. Daemon log: $DATA_DIR/logs/agent.log"
exit 0
