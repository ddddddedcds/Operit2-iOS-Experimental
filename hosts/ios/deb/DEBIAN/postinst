#!/bin/bash
# Run as root on the jailbroken device after `dpkg -i`.
set -u

# roothide installs to / (dpkg remaps package paths into the random jbroot);
# rootless installs to /var/jb. Detect so the paths below are correct on both.
if [ -L /var/jb ] || [ -d /var/jb/usr ]; then
  JB=/var/jb
else
  JB=
fi
echo "== Operit2 iOS install (JB prefix='${JB:-<none>}') =="

echo "== socket / log directories =="
mkdir -p ${JB}/var/mobile/.operit 2>/dev/null || true
chown -R mobile:mobile ${JB}/var/mobile/.operit 2>/dev/null || true
mkdir -p ${JB}/var/mobile/.operit/logs 2>/dev/null || true
chown -R mobile:mobile ${JB}/var/mobile/.operit/logs 2>/dev/null || true

echo "== agent daemon permissions (runs as root via LaunchDaemon) =="
chown root:wheel ${JB}/usr/bin/operit_agent_daemon 2>/dev/null || true
chmod 0755 ${JB}/usr/bin/operit_agent_daemon 2>/dev/null || true
# Best-effort re-sign on-device; the binary is already signed at build time
# (macOS ldid for roothide), so a flaky device ldid is non-fatal.
ldid -S ${JB}/usr/bin/operit_agent_daemon 2>/dev/null || true

echo "== load agent daemon =="
if [ -n "$JB" ]; then
  launchctl load ${JB}/Library/LaunchDaemons/ai.operit.agent.plist 2>/dev/null || \
    launchctl bootstrap system ${JB}/Library/LaunchDaemons/ai.operit.agent.plist 2>/dev/null || true
else
  launchctl load /Library/LaunchDaemons/ai.operit.agent.plist 2>/dev/null || \
    launchctl bootstrap system /Library/LaunchDaemons/ai.operit.agent.plist 2>/dev/null || true
fi

echo "== reload SpringBoard so the control tweak takes effect =="
if command -v sbreload >/dev/null 2>&1; then
  sbreload 2>/dev/null || true
else
  echo "（未找到 sbreload，请手动 respring / 注销以使 SpringBoard tweak 生效）"
fi

echo "== frontend app install (sign + register) =="
APP=${JB}/Applications/Runner.app
if [ -d "$APP" ]; then
  echo "   signing app executables (best-effort) ..."
  for bin in "$APP/Runner" \
             "$APP/Frameworks/Flutter.framework/Flutter" \
             "$APP/Frameworks/App.framework/App" \
             "$APP/Frameworks/objective_c.framework/objective_c"; do
    [ -f "$bin" ] && ldid -S "$bin" 2>/dev/null || true
  done
  find "$APP/Frameworks" -maxdepth 1 -name "*.dylib" -type f -exec ldid -S {} \; 2>/dev/null || true
  chown -R root:wheel "$APP" 2>/dev/null || true
  find "$APP" -type d -exec chmod 0755 {} \; 2>/dev/null || true
  chmod 0755 "$APP/Runner" 2>/dev/null || true
  if command -v uicache >/dev/null 2>&1; then uicache 2>/dev/null || true; fi
  echo "   app registered at $APP"
else
  echo "   (no bundled app found at $APP; frontend not included in this deb)"
fi

echo "Operit2 iOS installed. Daemon log: ${JB}/var/mobile/.operit/logs/agent.log"
exit 0
