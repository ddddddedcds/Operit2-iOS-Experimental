#!/bin/sh
# Run as root on the jailbroken device after `dpkg -i` (roothide scheme only).
set -u

# roothide installs to / (dpkg remaps package paths into the random jbroot);
# rootless installs to /var/jb. Detect so the paths below are correct on both.
if [ -L /var/jb ] || [ -d /var/jb/usr ]; then
  JB=/var/jb
else
  JB=
fi
echo "== Operit2 iOS install (JB prefix='${JB:-<none>}') =="

# Locate the device ldid. Its install path varies by jailbreak toolchain
# (Procursus commonly uses /usr/bin/ldid, but some setups install to
# /usr/local/bin/ldid). A hardcoded /usr/bin/ldid that MISSES on the device
# means the daemon is NEVER re-signed -> AMFI SIGKILL (-9) -> white screen,
# with the failure silently swallowed. Probe the common locations instead of
# assuming one, so the log always shows whether ldid was actually found.
LDID_BIN=""
for _c in /usr/bin/ldid /usr/local/bin/ldid; do
  [ -x "$_c" ] && LDID_BIN="$_c" && break
done
[ -z "$LDID_BIN" ] && LDID_BIN="$(command -v ldid 2>/dev/null || true)"
echo "== ldid resolved to: ${LDID_BIN:-<NOT FOUND>} =="

echo "== socket / log directories =="
mkdir -p ${JB}/var/mobile/.operit 2>/dev/null || true
chown -R mobile:mobile ${JB}/var/mobile/.operit 2>/dev/null || true
mkdir -p ${JB}/var/mobile/.operit/logs 2>/dev/null || true
chown -R mobile:mobile ${JB}/var/mobile/.operit/logs 2>/dev/null || true

echo "== agent daemon permissions + on-device re-sign (runs as root via LaunchDaemon) =="
chown root:wheel ${JB}/usr/bin/operit_agent_daemon 2>/dev/null || true
chmod 0755 ${JB}/usr/bin/operit_agent_daemon 2>/dev/null || true
# The binary is pre-signed at build time with macOS ldid, whose certificate is
# NOT in the device's AMFI trust cache -> roothide's AMFI SIGKILLs it on exec
# (launchctl ExitCode 9, agent.sock never appears -> app white-screen). Re-sign
# on-device with the roothide ldid so the trusted cert lands in the AMFI trust
# cache. MUST pass the entitlements file explicitly: a bare `ldid -S` would strip
# platform-application + no-sandbox and the daemon then fails sandbox/file-access.
# device ldid occasionally dies with 137 (SIGKILL itself) -> retry a few times.
# Nothing here is `|| true` silent: every attempt is logged to postinst.log so a
# failed sign is visible instead of masquerading as "installed fine".
ENTFILE=${JB}/usr/share/operit/operit.entitlements
DAEMON_BIN=${JB}/usr/bin/operit_agent_daemon
PINST_LOG=${JB}/var/mobile/.operit/logs/postinst.log
if [ -n "$LDID_BIN" ] && [ -f "$DAEMON_BIN" ]; then
  if [ -f "$ENTFILE" ]; then
    for i in 1 2 3 4 5; do
      echo "$(date) ldid -S daemon attempt $i (using $LDID_BIN)" >> "$PINST_LOG" 2>&1
      if $LDID_BIN -S"$ENTFILE" "$DAEMON_BIN" >> "$PINST_LOG" 2>&1; then
        echo "$(date) daemon signed OK on attempt $i" >> "$PINST_LOG" 2>&1
        break
      else
        echo "$(date) ldid attempt $i FAILED (rc=$?), retrying" >> "$PINST_LOG" 2>&1
        sleep 1
      fi
    done
  else
    echo "$(date) WARN: entitlements missing ($ENTFILE); signing daemon WITHOUT entitlements" >> "$PINST_LOG" 2>&1
    $LDID_BIN -S "$DAEMON_BIN" >> "$PINST_LOG" 2>&1 || true
  fi
  echo "$(date) daemon entitlements after sign:" >> "$PINST_LOG" 2>&1
  $LDID_BIN -e "$DAEMON_BIN" >> "$PINST_LOG" 2>&1 || true
else
  echo "$(date) WARN: ldid not found (probed /usr/bin/ldid, /usr/local/bin/ldid, PATH) or daemon missing; daemon will likely SIGKILL (-9)" >> "$PINST_LOG" 2>&1
fi

echo "== load agent daemon =="
if [ -n "$JB" ]; then
  launchctl load ${JB}/Library/LaunchDaemons/ai.operit.agent.plist 2>/dev/null || \
    launchctl bootstrap system ${JB}/Library/LaunchDaemons/ai.operit.agent.plist 2>/dev/null || true
else
  launchctl load /Library/LaunchDaemons/ai.operit.agent.plist 2>/dev/null || \
    launchctl bootstrap system /Library/LaunchDaemons/ai.operit.agent.plist 2>/dev/null || true
fi

echo "== reload SpringBoard so the control tweak takes effect =="
if command -v sbreload >/dev/null 2>&1; then
  sbreload 2>/dev/null || true
else
  echo "（未找到 sbreload，请手动 respring / 注销以使 SpringBoard tweak 生效）"
fi

echo "== frontend app install (sign + register) =="
APP=${JB}/Applications/Runner.app
if [ -d "$APP" ]; then
  # Re-sign app binaries on-device with the SAME entitlements the build used
  # (Runner.roothide.entitlements: no-sandbox + iokit for Metal/IOSurface).
  # A bare `ldid -S` (no file) would STRIP those keys -> Impeller SIGABRT / Metal
  # denied at launch. If ldid or the entitlements file is missing, skip and let
  # AppSync Unified (already installed) sign the app instead.
  if [ -n "$LDID_BIN" ] && [ -f "$ENTFILE" ]; then
    echo "   signing app executables with entitlements (best-effort) ..."
    for bin in "$APP/Runner" \
               "$APP/Frameworks/Flutter.framework/Flutter" \
               "$APP/Frameworks/App.framework/App" \
               "$APP/Frameworks/objective_c.framework/objective_c"; do
      [ -f "$bin" ] && $LDID_BIN -S"$ENTFILE" "$bin" 2>/dev/null || true
    done
    find "$APP/Frameworks" -maxdepth 1 -name "*.dylib" -type f -exec $LDID_BIN -S"$ENTFILE" {} \; 2>/dev/null || true
  else
    echo "   (ldid or entitlements missing; relying on AppSync Unified to sign app)"
  fi
  chown -R root:wheel "$APP" 2>/dev/null || true
  find "$APP" -type d -exec chmod 0755 {} \; 2>/dev/null || true
  chmod 0755 "$APP/Runner" 2>/dev/null || true
  if command -v uicache >/dev/null 2>&1; then uicache 2>/dev/null || true; fi
  echo "   app registered at $APP"
else
  echo "   (no bundled app found at $APP; frontend not included in this deb)"
fi

echo "Operit2 iOS installed. Daemon log: ${JB}/var/mobile/.operit/logs/agent.log"
exit 0
