#!/bin/sh
# Run as root on the jailbroken device after `dpkg -i` (rootless only).
set -u

# Rootless-only: this fork targets Dopamine/ElleKit rootless. Everything lives
# under /var/jb (binaries) and the REAL /var/mobile/.operit (data). All
# roothide detection / dual-path logic has been removed.
JB=/var/jb
echo "== Operit2 iOS install (rootless, JB=${JB}) =="

# Data directory for sockets / logs / config. The REAL /var/mobile/.operit:
# the app (containerized UIKitApplication) can write here but NOT into the
# procursus tree (/private/preboot) — using /var/jb for data was an EACCES
# crash on every fresh install.
DATA_DIR="/var/mobile/.operit"

# Locate the device ldid. Its install path varies by jailbreak toolchain
# (Procursus commonly uses /usr/bin/ldid, but some setups install to
# /usr/local/bin/ldid). A hardcoded /usr/bin/ldid that MISSES on the device
# means the daemon is NEVER re-signed -> AMFI SIGKILL (-9) -> white screen,
# with the failure silently swallowed. Probe the common locations instead of
# assuming one, so the log always shows whether ldid was actually found.
LDID_BIN=""
for _c in /usr/bin/ldid /usr/local/bin/ldid; do
  [ -x "$_c" ] && LDID_BIN="$_c" && break
done
[ -z "$LDID_BIN" ] && LDID_BIN="$(command -v ldid 2>/dev/null || true)"
echo "== ldid resolved to: ${LDID_BIN:-<NOT FOUND>} =="

echo "== socket / log directories =="
_DATA_CANDIDATES="/var/mobile/.operit"
for _d in $_DATA_CANDIDATES; do
  mkdir -p "$_d" 2>/dev/null || true
  if chown -R mobile:mobile "$_d" 2>/dev/null; then
    echo "   chowned $_d -> mobile:mobile OK"
  else
    echo "   WARN: chown $_d failed (likely created as root by the daemon)"
  fi
  mkdir -p "$_d/logs" 2>/dev/null || true
  chown -R mobile:mobile "$_d/logs" 2>/dev/null || true
  # Rootless-only runtime layout: the app's runtime storage root is
  # <data>/runtime (PathMapper maps /app/data/<x> -> <runtimeRoot>/<x>, the
  # "data" VFS segment is consumed). AppLogger writes <runtimeRoot>/logs, and
  # core uses <runtimeRoot>/temp. Without these dirs owned by mobile the core
  # panics with "runtime log files must be configured ... Permission denied".
  mkdir -p "$_d/runtime/logs" 2>/dev/null || true
  mkdir -p "$_d/runtime/temp" 2>/dev/null || true
  chown -R mobile:mobile "$_d/runtime" 2>/dev/null || true
done

# --- agent daemon (restored 0.3.65): re-sign on-device + register in trustcache ---
PINST_LOG="$DATA_DIR/logs/postinst.log"
DAEMON_BIN=${JB}/usr/bin/operit_agent_daemon
DAEMON_ENTFILE=${JB}/usr/share/operit/operit.entitlements
echo "== agent daemon re-sign + trustcache (runs as root via dpkg) =="
if [ -f "$DAEMON_BIN" ]; then
  chown root:wheel "$DAEMON_BIN" 2>/dev/null || true
  chmod 0755 "$DAEMON_BIN" 2>/dev/null || true
  # Re-sign with ldid so a trusted cert lands in the AMFI trust cache. MUST pass
  # the entitlements explicitly: a bare `ldid -S` strips platform-application +
  # no-sandbox and the daemon then fails sandbox/jbroot file-access. ldid
  # occasionally dies with 137 (SIGKILL itself) -> retry a few times.
  if [ -n "$LDID_BIN" ] && [ -f "$DAEMON_ENTFILE" ]; then
    _daemon_signed=0
    for i in 1 2 3; do
      echo "$(date) ldid -S daemon attempt $i (using $LDID_BIN)" >> "$PINST_LOG" 2>&1
      if $LDID_BIN -S"$DAEMON_ENTFILE" "$DAEMON_BIN" >> "$PINST_LOG" 2>&1; then
        echo "$(date) daemon signed OK on attempt $i" >> "$PINST_LOG" 2>&1
        _daemon_signed=1
        break
      else
        echo "$(date) ldid attempt $i FAILED (rc=$?), retrying" >> "$PINST_LOG" 2>&1
        sleep 1
      fi
    done
    if [ "$_daemon_signed" = 1 ]; then
      # Dump entitlements actually applied (evidence for debugging -9).
      echo "$(date) daemon entitlements after sign:" >> "$PINST_LOG" 2>&1
      $LDID_BIN -e "$DAEMON_BIN" >> "$PINST_LOG" 2>&1 || true
    else
      echo "$(date) daemon re-sign FAILED after 3 attempts" >> "$PINST_LOG" 2>&1
      echo "   ⚠️ WARNING: daemon re-sign FAILED — daemon may SIGKILL (-9) at launch"
    fi
  else
    echo "$(date) WARN: ldid/entitlements missing; daemon will likely SIGKILL (-9)" >> "$PINST_LOG" 2>&1
    echo "   ⚠️ WARNING: ldid/entitlements MISSING — daemon not re-signed; will likely SIGKILL (-9)"
  fi
  # Register the daemon's cdhash in the jailbreak trustcache so AMFI does NOT
  # SIGKILL (-9) it at exec. This is the step that was missing when packdeb.py
  # omitted postinst from the .deb: the daemon was never trusted -> -9 -> (with
  # KeepAlive) the device reboot-loop. trustcache add takes the 40-hex cdhash
  # (not a path), which is why this uses `ldid -h` to extract it first.
  JBCTL="$(command -v jbctl 2>/dev/null || true)"
  [ -z "$JBCTL" ] && [ -x /basebin/jbctl ] && JBCTL=/basebin/jbctl
  if [ -n "$JBCTL" ] && [ -n "$LDID_BIN" ] && [ -f "$DAEMON_BIN" ]; then
    _cd=$($LDID_BIN -h "$DAEMON_BIN" 2>/dev/null | grep -m1 '^CDHash' | awk '{print $2}')
    if [ -n "$_cd" ]; then
      if $JBCTL trustcache add "$_cd" >> "$PINST_LOG" 2>&1; then
        echo "   daemon cdhash registered in trustcache (AMFI will trust it)"
      else
        echo "   ⚠️ WARNING: jbctl trustcache add FAILED for daemon (rc=$?) — daemon may SIGKILL (-9)"
      fi
    else
      echo "   ⚠️ WARNING: could not extract daemon cdhash (ldid -h)"
    fi
  else
    echo "   ⚠️ WARNING: jbctl/ldid missing — daemon NOT in trustcache; may SIGKILL (-9) -> reboot loop"
  fi
else
  echo "   (no daemon binary at $DAEMON_BIN; agent daemon not included)"
fi

echo "== load agent daemon =="
# Do NOT let `launchctl load` block postinst: if the daemon loops on launch,
# launchctl would hang and break the install. Dopamine's launchdhook auto-injects
# JBROOT/Library/LaunchDaemons anyway, and RunAtLoad in the plist makes launchd
# start the daemon independently of this step.
load_daemon() {
  _plist="$1"
  if [ -f "$_plist" ]; then
    timeout 10 launchctl load "$_plist" 2>/dev/null || \
      timeout 10 launchctl bootstrap system "$_plist" 2>/dev/null || true
  fi
}
if [ -n "$JB" ]; then
  load_daemon ${JB}/Library/LaunchDaemons/ai.operit.agent.plist
else
  load_daemon /Library/LaunchDaemons/ai.operit.agent.plist
fi
APP_ENTFILE=${JB}/usr/share/operit/operit.entitlements

echo "== NOTE: 安装脚本不自动 respring（sbreload 会重启 SpringBoard，而 Sileo/Zebra 等本身跑在 SpringBoard 上，自杀式 respring 会中断安装器并留下半配置状态）=="
echo "   装完后请手动 respring：Sileo 设置内按钮，或终端 sbreload，使 SpringBoard tweak 生效。"

echo "== frontend app install (sign + register) =="
APP=${JB}/Applications/Runner.app
if [ -d "$APP" ]; then
  # Re-sign app binaries on-device with the SAME entitlements the build used
  # (Runner.entitlements: no-sandbox + iokit for Metal/IOSurface). A bare
  # `ldid -S` (no file) would STRIP those keys -> Impeller SIGABRT / Metal
  # denied at launch. If ldid or the entitlements file is missing, skip and let
  # AppSync Unified (already installed) sign the app instead.
  if [ -n "$LDID_BIN" ] && [ -f "$APP_ENTFILE" ]; then
    echo "   signing app executables with entitlements ..."
    _app_sign_fail=0
    for bin in "$APP/Runner" \
               "$APP/Frameworks/Flutter.framework/Flutter" \
               "$APP/Frameworks/App.framework/App" \
               "$APP/Frameworks/objective_c.framework/objective_c"; do
      if [ -f "$bin" ]; then
        if ! $LDID_BIN -S"$APP_ENTFILE" "$bin" >> "$PINST_LOG" 2>&1; then
          echo "   ⚠️ WARNING: ldid FAILED on $bin (app may SIGKILL at launch)"; _app_sign_fail=1
        fi
      fi
    done
    for _dyl in $(find "$APP/Frameworks" -maxdepth 1 -name "*.dylib" -type f 2>/dev/null); do
      if ! $LDID_BIN -S"$APP_ENTFILE" "$_dyl" >> "$PINST_LOG" 2>&1; then
        echo "   ⚠️ WARNING: ldid FAILED on $_dyl"; _app_sign_fail=1
      fi
    done
    [ "$_app_sign_fail" = 1 ] && echo "   ⚠️ APP SIGNING HAD FAILURES — see $PINST_LOG; app may white-screen until re-signed."
  else
    echo "   ⚠️ WARNING: ldid or entitlements MISSING — app NOT re-signed; relying on AppSync Unified (risky)."
  fi
  chown -R root:wheel "$APP" 2>/dev/null || true
  find "$APP" -type d -exec chmod 0755 {} \; 2>/dev/null || true
  chmod 0755 "$APP/Runner" 2>/dev/null || true
  if command -v uicache >/dev/null 2>&1; then uicache 2>/dev/null || true; fi
  echo "   app registered at $APP"

  # --- trustcache：注册 app 全部 Mach-O 的 cdhash 到 jailbreak trustcache ---
  # Dopamine 的 AMFI 对 dlopen 的 app 内嵌 framework 做严格 cdhash 校验：
  # 不注册则报 "code signature invalid"（objective_c.framework 真机实测，
  # 注册后即修复）。Dopamine 主版 jbctl 收 `<cdhash>`（40 位 hex），用
  # `ldid -h` 提取。必须放在上面 ldid 重签之后（cdhash 随签名变化）。
  # best-effort，失败仅记日志。
  JBCTL="$(command -v jbctl 2>/dev/null || true)"
  [ -z "$JBCTL" ] && [ -x /basebin/jbctl ] && JBCTL=/basebin/jbctl
  if [ -n "$JBCTL" ] && [ -n "$LDID_BIN" ]; then
    echo "   [trustcache] registering app Mach-O cdhashes ..."
    _reg=0
    for _bin in "$APP/Runner" \
        $(find "$APP/Frameworks" -maxdepth 2 -type f -perm -111 2>/dev/null) \
        $(find "$APP/PlugIns" -maxdepth 3 -type f -perm -111 2>/dev/null); do
      [ -f "$_bin" ] || continue
      _cd=$($LDID_BIN -h "$_bin" 2>/dev/null | grep -m1 '^CDHash' | awk '{print $2}')
      [ -n "$_cd" ] || continue
      if $JBCTL trustcache add "$_cd" >> "$PINST_LOG" 2>&1; then
        _reg=$((_reg + 1))
      fi
    done
    echo "   [trustcache] registered $_reg binaries under $APP"
  else
    echo "   [trustcache] WARN: jbctl/ldid not found; dlopen'd frameworks may fail with code signature invalid"
  fi
else
  echo "   (no bundled app found at $APP; frontend not included in this deb)"
fi

echo "Operit2 iOS installed. Daemon log: $DATA_DIR/logs/agent.log"
exit 0
